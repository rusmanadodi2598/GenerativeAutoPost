# Copy to app-ui/.env and fill values. Never commit .env.
# The admin UI talks to app-serve only; TikTok credentials stay server-side.

# Base URL of the API, including the /api/v1 prefix
PUBLIC_API_BASE_URL=
# Base URL of the public webhook host (signup links, deep links)
PUBLIC_WEBHOOK_HOST=
# development or production, controls debug detail
PUBLIC_APP_ENV=
