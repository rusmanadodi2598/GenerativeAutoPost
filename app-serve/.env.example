# Copy to app-serve/.env and fill values. Never commit .env.
# Every key maps to docs/SPEC/001 section 11.

# development or production, controls debug detail
APP_ENV=
# Listen port
APP_PORT=
# PostgreSQL 17 DSN
DATABASE_URL=
# Pool limits, set explicitly per AGENTS.md 1.7
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
DB_CONN_MAX_LIFETIME=
# Redis 7 DSN
REDIS_URL=
# TikTok app credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match the registered URI exactly
TIKTOK_REDIRECT_URI=
# Comma-joined scope list
TIKTOK_SCOPES=
# AES-256-GCM master key (exactly 32 bytes) and rotation id
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_ID=
# disk or s3
MEDIA_DRIVER=
# Verified domain used for PULL_FROM_URL
MEDIA_PUBLIC_BASE_URL=
# Cloudflare R2 settings
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Session settings
SESSION_COOKIE_NAME=
SESSION_TTL=
# slog level
LOG_LEVEL=
