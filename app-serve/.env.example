# Copy to app-serve/.env and fill values. Never commit .env.
# Every key maps to docs/SPEC/001 section 11.

# development or production, controls debug detail
APP_ENV=
# Listen port
APP_PORT=
# PostgreSQL 17 DSN
DATABASE_URL=
# Pool limits, set explicitly per AGENTS.md 1.7
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
DB_CONN_MAX_LIFETIME=
# Redis 7 DSN. A password goes in the userinfo slot, as in
# redis://:password@127.0.0.1:6380/0
REDIS_URL=
# TikTok app credentials. Both are required at boot; the secret doubles as
# the webhook HMAC key, so boot refuses an empty value.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match the registered URI exactly
TIKTOK_REDIRECT_URI=
# Comma-joined scope list
TIKTOK_SCOPES=
# Google OAuth client id for operator sign in
GOOGLE_CLIENT_ID=
# Google OAuth client secret for operator sign in
GOOGLE_CLIENT_SECRET=
# Must match the registered Google redirect URI exactly
GOOGLE_REDIRECT_URI=
# The one email allowed to sign in
OPERATOR_EMAIL=
# Console origin for browser redirects, empty means same-origin
APP_UI_BASE_URL=
# Comma-joined proxy IPs/CIDRs allowed to set X-Forwarded-For. Empty trusts
# no proxy, so ClientIP is always the peer address.
TRUSTED_PROXIES=
# AES-256-GCM master key (exactly 32 bytes) and rotation id
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_ID=
# Dashboard operator identity; must be the `users` row the login upserts, and
# the signed in email must match OPERATOR_EMAIL
OPERATOR_ID=
# disk or s3
MEDIA_DRIVER=
# Local object root, required when MEDIA_DRIVER=disk
MEDIA_ROOT=
# Verified domain used for PULL_FROM_URL
MEDIA_PUBLIC_BASE_URL=
# Upload caps: request body bound per file, chunk body bound per PUT
MEDIA_MAX_BYTES=
MEDIA_MAX_DURATION_MS=
# Comma-joined allow list for stored content types
MEDIA_ALLOWED_TYPES=
CHUNK_MAX_BYTES=
# Cloudflare R2 settings
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Webhook worker pool size
WORKER_SIZE=
# Stats worker: sweep cadence and the 7 day retention window
STATS_REFRESH_INTERVAL=
STATS_RETENTION=
# Per-IP webhook intake throttle: window and max deliveries in it
WEBHOOK_THROTTLE_WINDOW=
WEBHOOK_THROTTLE_MAX=
# Set true once to apply migrations then exit (requires MIGRATIONS_DIR)
RUN_MIGRATIONS=
MIGRATIONS_DIR=
# Session settings
SESSION_COOKIE_NAME=
SESSION_TTL=
# slog level
LOG_LEVEL=
